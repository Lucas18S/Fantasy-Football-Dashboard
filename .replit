entrypoint = "dashboard.py"
modules = ["python-3.11"]

[nix]
channel = "stable-25_05"
packages = ["glibcLocales", "xcodebuild", "zlib"]

[unitTest]
language = "python3"

[gitHubImport]
requiredFiles = [".replit", "replit.nix"]

[deployment]
run = ["streamlit", "run", "dashboard.py"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 8501
externalPort = 80
